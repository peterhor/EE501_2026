# macOS
.DS_Store
*/.thumbnail

# Source materials not meant for the public site (exercises, slides,
# playsheets, copyrighted references) — distributed to students via Canvas.
*/uploads
*/screenshots
Goosse2010_textbook/*
figures/*
animations/*

# Report/solution figures, not used by the interactive labs themselves.
*/figures

# Answer keys / worked solutions — never for students.
*Report*.docx
*Report*.dc.html
*FASIT*
*reportHR*

# Answer-key variants of the interactive labs stay out. The eight lecture
# running orders are the exception and are deliberately tracked (see README):
# they live in the lecture folders, never under docs/, so they are in the
# repository but not on the published site.
*Teacher*.html
*Teacher*.dc.html
!lecture-*/Lecture?-Teacher-outline.html

# Lightweight ".dc.html" preview variants and their runtime — these need
# support.js/doc-page.js to render and duplicate the self-contained
# "(Student)" bundles used for the public site. Kept out to avoid confusion.
*.dc.html
!lecture-5-modelling-the-climate-system/atmospheric-equations/Governing Equations of the Atmosphere.dc.html
!lecture-2-earths-energy-budget/insolation/Earth Insolation v2.dc.html
!lecture-3-climate-at-a-local-scale/explorer-standalone-src.dc.html
doc-page.js
support.js

# ...except inside docs/ — that's the published site itself (see README), so
# its own copy of the runtime is required, not a stray duplicate.
!docs/**/doc-page.js
!docs/**/support.js
lecture-1-components-of-the-climate-system/Lecture 1 - Components of the Climate System.pptx
lecture-2-earths-energy-budget/Lecture 2 - The Earths Energy Budget.pptx
lecture-3-climate-at-a-local-scale/Lecture3-Climate-at-a-local-scale2025.pptx
lecture-4-global-cycles-water-and-carbon/Lecture4-Global-cycles-of-water-and-carbon2025.pptx
lecture-5-modelling-the-climate-system/Lecture5-Modelling-the-climate-system2025.pptx
lecture-6-response-of-the-climate-system-to-perturbations/Lecture6-Response-of-the-climate-system-to-perturbations2025.pptx
lecture-7-climate-change-past-and-present/Lecture7-Climate-change-past-and-present2025.pptx
lecture-8-climate-change-the-future/Lecture8-Climate-change-the future2026.pptx
